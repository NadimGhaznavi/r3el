[Unit]
Description=R3el server
After=network.target mariadb.service

[Service]
Type=simple
User=r3el
Group=r3el
WorkingDirectory=@APP@
EnvironmentFile=/etc/r3el/database.env
EnvironmentFile=/etc/r3el/tmdb.env
Environment=R3EL_LLM_URL=http://127.0.0.1:@LLM_PORT@
EnvironmentFile=-/etc/r3el/server.env
ExecStart="@APP@/.venv/bin/python" -B -u -m r3el.server.R3elServer
Restart=no

[Install]
WantedBy=multi-user.target
